# Allowlist-style .gitignore: everything is ignored by default, and only the
# files explicitly un-ignored below are tracked. This keeps scratch files,
# model checkpoints, and abandoned-approach leftovers from accidentally
# getting committed later.
*
!.gitignore
!README.md
!RESULTS_SUMMARY.md

# --- dataset/: generation pipeline, schema, and the benchmark itself ---
!dataset/
!dataset/build_dataset.py
!dataset/export_benchmark.py
!dataset/validate_dataset.py
!dataset/labels.json
!dataset/benchmark_clinical_phi.jsonl
!dataset/benchmark_clinical_phi.train.jsonl
!dataset/benchmark_clinical_phi.test.jsonl
!dataset/benchmark_clinical_phi.validation.jsonl

# --- evaluation/: shared scoring infra + one script per in-scope model ---
!evaluation/
!evaluation/sota_eval_common.py
!evaluation/sota_eval_presidio.py
!evaluation/sota_eval_obi_i2b2.py
!evaluation/sota_eval_stanford_deid.py
!evaluation/sota_eval_spacy.py
!evaluation/sota_eval_gliner_biomed.py
!evaluation/sota_eval_clinical_ai_apollo.py
!evaluation/sota_eval_biomedical_ner_all.py

# --- diagnostics/: root-cause scripts for specific findings + raw output ---
!diagnostics/
!diagnostics/diag_apollo_offsets.py
!diagnostics/diag_apollo_age_disease.py
!diagnostics/diag_d4data_date.py
!diagnostics/diag_gliner_offsets.py
!diagnostics/diag_obi_email.py

# --- confusion_matrices/: one PNG per in-scope model ---
